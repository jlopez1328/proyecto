{
  "name": "nexusstock", "version": "1.0.0", "private": true,
  "workspaces": ["frontend", "backend"],
  "engines": {"node": ">=22"},
  "scripts": {
    "dev": "concurrently -k -n API,WEB \"npm run dev -w backend\" \"npm run dev -w frontend\"",
    "local": "node scripts/local.mjs",
    "build": "npm run build -w frontend",
    "start": "npm run start -w backend",
    "test": "npm run test -w backend && npm run test -w frontend",
    "seed": "npm run seed -w backend",
    "setup": "node scripts/setup.mjs",
    "package": "node scripts/package.mjs",
    "check": "npm test && npm run build"
  },
  "devDependencies": {"concurrently": "^10.0.7"}
}
